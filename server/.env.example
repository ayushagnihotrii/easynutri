# EasyNutri Environment Configuration Template for Docker Compose

# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=easynutri
DB_USER=easynutri
DB_PASSWORD=your_secure_db_password_here

# Server configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Initial Administrator Bootstrap (One-time setup on clean install; unset after initial boot)
# When configured, EasyNutri initializes an initial administrator account if none exists.
# When left unset, no default administrator is provisioned automatically.
# EASYNUTRI_ADMIN_BOOTSTRAP_USERNAME=admin
# EASYNUTRI_ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
# EASYNUTRI_ADMIN_BOOTSTRAP_PASSWORD=your_secure_admin_password_here
