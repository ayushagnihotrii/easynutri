<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l">

    <ImageView
        android:id="@+id/iv_placeholder_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_food_placeholder"
        app:tint="@color/brand_primary" />

    <TextView
        android:id="@+id/tv_placeholder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_headline_medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_placeholder_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

</LinearLayout>

