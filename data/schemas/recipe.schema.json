{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "required": [
    "id",
    "title_en",
    "title_hi",
    "base_servings",
    "prep_minutes",
    "cook_minutes",
    "meal_slot",
    "meal_role",
    "ingredients",
    "steps",
    "source",
    "verified"
  ],
  "properties": {
    "id": { "type": "string" },
    "title_en": { "type": "string" },
    "title_hi": { "type": "string" },
    "base_servings": { "type": "integer", "minimum": 1 },
    "prep_minutes": { "type": "integer", "minimum": 0 },
    "cook_minutes": { "type": "integer", "minimum": 0 },
    "meal_slot": {
      "type": "string",
      "enum": ["BREAKFAST", "LUNCH", "DINNER", "SNACK"]
    },
    "meal_role": {
      "type": "string",
      "enum": ["MAIN", "DESSERT", "SIDE", "SALAD"]
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["food_id", "amount_g"],
        "properties": {
          "food_id": { "type": "string" },
          "amount_g": { "type": "number", "minimum": 0.1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": {
      "type": "string",
      "enum": ["SYSTEM", "COMMUNITY", "USER", "SAMPLE"]
    },
    "verified": { "type": "boolean" }
  }
}

