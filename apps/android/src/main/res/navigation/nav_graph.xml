<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.easynutri.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_discover"
        android:name="com.easynutri.ui.discover.DiscoverFragment"
        android:label="@string/nav_discover"
        tools:layout="@layout/fragment_discover" />

    <fragment
        android:id="@+id/navigation_planner"
        android:name="com.easynutri.ui.planner.PlannerFragment"
        android:label="@string/nav_planner"
        tools:layout="@layout/fragment_planner" />

    <fragment
        android:id="@+id/navigation_diary"
        android:name="com.easynutri.ui.diary.DiaryFragment"
        android:label="@string/nav_diary"
        tools:layout="@layout/fragment_diary" />

    <fragment
