<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EasyNutri" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_inverse</item>
        <item name="colorPrimaryContainer">@color/brand_secondary</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/outline_subtle</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
    </style>
</resources>

