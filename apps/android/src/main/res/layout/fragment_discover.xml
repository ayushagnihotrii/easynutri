<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/discover_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline_large"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Explore clinical recipes and verify nutritional safety"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Multi-Channel Input Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_m">

            <Button
                android:id="@+id/btn_voice_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_voice_search"
                android:textSize="11sp"
                app:icon="@drawable/ic_mic"
                app:iconSize="16dp"
                style="@style/Widget.EasyNutri.Button.Secondary" />

            <Button
                android:id="@+id/btn_camera_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="@string/btn_camera_search"
                android:textSize="11sp"
                app:icon="@drawable/ic_camera"
                app:iconSize="16dp"
                style="@style/Widget.EasyNutri.Button.Secondary" />

            <Button
                android:id="@+id/btn_barcode_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/btn_barcode_search"
                android:textSize="11sp"
                app:icon="@drawable/ic_barcode"
                app:iconSize="16dp"
                style="@style/Widget.EasyNutri.Button.Secondary" />
        </LinearLayout>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/search_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:hint="@string/search_foods_hint"
            app:startIconDrawable="@drawable/ic_search"
            app:endIconMode="clear_text"
            app:boxCornerRadiusTopStart="@dimen/radius_small"
            app:boxCornerRadiusTopEnd="@dimen/radius_small"
            app:boxCornerRadiusBottomStart="@dimen/radius_small"
            app:boxCornerRadiusBottomEnd="@dimen/radius_small"
            app:boxStrokeColor="@color/brand_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ingredient Matcher Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            style="@style/Widget.EasyNutri.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥕 What's in your kitchen?"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Enter ingredients separated by commas to find matching recipes"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_s">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ingredients"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/ic_food_placeholder"
                        android:backgroundTint="@color/brand_secondary"
                        android:paddingHorizontal="@dimen/spacing_s"
                        android:hint="e.g. paneer, spinach, garlic"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_match_ingredients"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="Find"
                        style="@style/Widget.EasyNutri.Button.Primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Results Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_l">

            <TextView
                android:id="@+id/tv_results_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available Recipes"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="No recipes found. Try a different search term or ingredient list."
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Recipe Results Container -->
        <LinearLayout
            android:id="@+id/layout_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_s" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
