<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Forest Green Button -->
    <style name="Widget.EasyNutri.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EasyNutri.Small</item>
    </style>

    <!-- Secondary Pale Mint Button -->
    <style name="Widget.EasyNutri.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/brand_secondary</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EasyNutri.Small</item>
    </style>

    <!-- Clean Outline Card -->
    <style name="Widget.EasyNutri.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="strokeColor">@color/outline_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EasyNutri.Medium</item>
    </style>

    <!-- Visible Sample Data Banner -->
    <style name="Widget.EasyNutri.Banner.SampleData" parent="">
        <item name="android:background">@color/brand_accent</item>
        <item name="android:padding">@dimen/spacing_s</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.EasyNutri.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.EasyNutri.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeAppearance.EasyNutri.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_large</item>
    </style>
</resources>
